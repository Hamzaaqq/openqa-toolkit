{
  "name": "hamzaaqq/openqa-toolkit",
  "description": "Lightweight PHP CLI for HTML quality checks, accessibility heuristics, HTTP headers and Laravel/CI integration.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "ext-curl": "*"
  },
  "bin": [
    "bin/openqa"
  ],
  "scripts": {
    "test": "php tests/run.php"
  },
  "keywords": [
    "qa",
    "html",
    "accessibility",
    "cli",
    "testing",
    "website-audit",
    "quality-assurance",
    "laravel",
    "github-actions",
    "security-headers"
  ],
  "homepage": "https://hamzaaqq.github.io/openqa-toolkit/",
  "support": {
    "issues": "https://github.com/Hamzaaqq/openqa-toolkit/issues",
    "source": "https://github.com/Hamzaaqq/openqa-toolkit",
    "docs": "https://hamzaaqq.github.io/openqa-toolkit/"
  },
  "autoload": {
    "psr-4": {
      "OpenQA\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OpenQA\\Laravel\\OpenQAServiceProvider"
      ]
    }
  },
  "suggest": {
    "laravel/framework": "Optional Artisan view auditing in Laravel applications (12.x or 13.x)."
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0"
  }
}
